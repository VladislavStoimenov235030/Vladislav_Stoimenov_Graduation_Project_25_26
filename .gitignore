# Raw dataset: never modified, never committed (tens of thousands of images).
data/raw/

# Processed datasets are regenerated from data/raw/ via scripts/create_rdd2022_4classes_small.py
# (deterministic with random.seed(42)), so they don't need to live in git.
data/processed/

# These are deterministic copies of data/manual/ produced by
# scripts/split_manual_dataset.py and scripts/split_manual_finetune_val.py --
# committing them would triple-store the same ~200 photos for no reason.
data/manual_split/
data/manual_finetune_split/

# YOLO training run artifacts (weights, batch previews, curves) — regenerated by training/eval runs.
notebooks/runs/
runs/

# Model weight files — large binaries, not suited to git history.
# Pretrained base weights (e.g. yolov8n.pt) can be re-downloaded; trained checkpoints are
# regenerated by re-running training and are kept locally / shared separately if needed.
*.pt

# Exception: the fine-tuned YOLOv8n checkpoint the deployed app actually
# uses (config/app_config.yaml: model.path) is small (~6MB) and committed
# so the app works out of the box. Faster R-CNN's checkpoints (~170MB each,
# not used by the app) stay excluded by the *.pt rule above.
!models/yolov8n_sofia_finetune/best.pt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
env/

# OS noise
.DS_Store
Thumbs.db

# osmnx's on-disk HTTP response cache (Overpass/Nominatim) -- speeds up
# repeated geospatial queries locally; safe to delete, rebuilt automatically.
cache/
